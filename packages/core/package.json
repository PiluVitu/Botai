      "./pis": {
        "types": "./dist/pis.d.ts",
        "default": "./dist/pis.js"
      },
      "./titulo-eleitor": {
        "types": "./dist/titulo-eleitor.d.ts",
        "default": "./dist/titulo-eleitor.js"
