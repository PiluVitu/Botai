      "./esquema/envelope-v1.schema.json": "./esquema/envelope-v1.schema.json",
      "./servidor": {
        "types": "./dist/servidor/index.d.ts",
        "default": "./dist/servidor/index.js"
      }
    }
  },
  "scripts": {
    "build": "node scripts/gerar-versao.mjs && rm -rf dist && tsc -p tsconfig.build.json && node scripts/extensoes.mjs dist",
    "prepack": "pnpm run build",
    "tarball": "pnpm run build && rm -rf pacote && pnpm pack --pack-destination pacote && mv pacote/*.tgz pacote/botai-core.tgz",
    "lint": "node scripts/gerar-versao.mjs --conferir && tsc --noEmit && pnpm run lint:sh",
    "test": "pnpm run build && jest && node --test scripts/*.test.mjs",
    "test:watch": "jest --watch",
    "lint:sh": "shellcheck scripts/*.sh"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "ajv": "^8.20.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  },
  "bin": {
    "botai": "dist/bin/botai.js"
  }
}
