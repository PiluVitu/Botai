{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom"],
    // Não é nodenext: no workspace o core exporta src/*.ts com imports relativos sem extensão (TS2835).
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "jest"]
  },
  "include": ["src", "playwright.config.ts"]
}
